PROJECT_NAME=ReefFusion Platform
DATABASE_URL=postgresql+psycopg://reefusion:reefusion@localhost:5432/reefusion
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=reefusion
S3_SECURE=false
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_PROVIDER=local
AI_ENABLED=true
AUTH_ENABLED=false
AUTH_ADMIN_TOKEN=local-admin-token
AUTH_EDITOR_TOKEN=local-editor-token

# Recording limits in MiB; input decoding/storage is streamed.
SURVEY_UPLOAD_LIMIT_MB=2048
SURVEY_DECOMPRESSED_LIMIT_MB=16384
